
# Aquí solo hay valores de ejemplo.

# Puerto donde se levanta el servicio
PORT=8080

# Conexión a PostgreSQL.
#   Local:  jdbc:postgresql://localhost:5432/sanomovil
#   Neon (nube, gratis): jdbc:postgresql://TU-HOST.neon.tech/neondb?sslmode=require   (ver docs/DESPLIEGUE_GRATIS.md)
DB_URL=jdbc:postgresql://localhost:5432/sanomovil
DB_USER=postgres
DB_PASSWORD=escribe_aqui_la_clave_de_tu_postgres

# Firma de los tokens de sesión (JWT). Usa un texto aleatorio de 32 o más caracteres.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio-de-32-o-mas-caracteres
JWT_ISSUER=sano-movil
JWT_TTL_MINUTES=120

# Administrador inicial (se crea al arrancar si no existe). Necesario para editar el catálogo de modelos.
ADMIN_EMAIL=admin@ejemplo.cl
ADMIN_PASSWORD=Cambia_Esta_Clave_123

# Solo poner true cuando el servicio corre detrás de un proxy (por ejemplo en Render). En tu PC déjalo en false.
TRUST_PROXY=false
